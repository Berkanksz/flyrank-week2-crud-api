# Copy this file to .env and set your own values:  cp .env.example .env
# .env is git-ignored. Never commit real credentials.

# Used by the postgres container (docker compose) to create the database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tasks

# Used by the app when you run it on your machine (uvicorn) against Postgres on localhost.
# Inside docker compose the app gets its own DATABASE_URL pointing at the "db" service.
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/tasks
